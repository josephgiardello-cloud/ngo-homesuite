# Flask Configuration
FLASK_APP=ngo_homesuite/main.py
FLASK_ENV=production
# Set either SECRET_KEY or FLASK_SECRET_KEY. If omitted, runtime generates one-time key.
SECRET_KEY=
FLASK_SECRET_KEY=

# Database Configuration
DATABASE_URL=sqlite:///ngo_homesuite.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/ngo_homesuite
# For MySQL:
# DATABASE_URL=mysql+pymysql://user:password@localhost/ngo_homesuite

# Database Encryption (Optional)
NGO_HOMESUITE_DB_KEY=

# Server Configuration
FLASK_DEBUG=False
FLASK_TESTING=False
HOST=127.0.0.1
PORT=8000

# Session Configuration
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=2592000

# Authentication
LOGIN_ATTEMPTS_LIMIT=5
LOGIN_ATTEMPTS_TIMEOUT=900

# Email Configuration (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
DEFAULT_MAIL_SENDER=noreply@ngohomesuite.local

# AWS Configuration (Optional - for S3 backup/storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=ngo-homesuite-backups

# Azure Configuration (Optional)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Ollama/AI Configuration (Optional)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2
COPILOT_ENABLED=True
COPILOT_RAG_K=6
COPILOT_TOOL_ALLOWLIST=list_recent_donations,search_donors,donor_profile_insights,summarize_donor,find_similar_donors,rank_donors_for_outreach,suggest_outreach_targets,draft_personalized_appeal,organization_financial_summary,generate_report,generate_grant_report_draft,create_donor,export_donors_snapshot,run_reconciliation,execute_donation_followup_workflow
COPILOT_REQUIRE_APPROVAL_TOKEN=True
COPILOT_APPROVAL_TOKEN_TTL_SEC=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ngo_homesuite.log
STRUCTURED_LOGS_JSON=True
METRICS_ENABLED=True

# Security
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000
RATE_LIMIT_ENABLED=True
RATELIMIT_DEFAULT=200 per day, 50 per hour
SESSION_COOKIE_SECURE=True

# Optional Azure Key Vault Integration (bring your own resolver in infra scripts)
AZURE_KEYVAULT_URL=
AZURE_SECRET_NAME_FLASK_KEY=
