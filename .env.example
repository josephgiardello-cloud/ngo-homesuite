# Flask Configuration
FLASK_APP=ngo_homesuite/main.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///ngo_homesuite.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/ngo_homesuite
# For MySQL:
# DATABASE_URL=mysql+pymysql://user:password@localhost/ngo_homesuite

# Database Encryption (Optional)
NGO_HOMESUITE_DB_KEY=

# Server Configuration
FLASK_DEBUG=True
FLASK_TESTING=False
HOST=127.0.0.1
PORT=5000

# Session Configuration
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=2592000

# Authentication
LOGIN_ATTEMPTS_LIMIT=5
LOGIN_ATTEMPTS_TIMEOUT=900

# Email Configuration (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
DEFAULT_MAIL_SENDER=noreply@ngohomesuite.local

# AWS Configuration (Optional - for S3 backup/storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=ngo-homesuite-backups

# Azure Configuration (Optional)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Ollama/AI Configuration (Optional)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ngo_homesuite.log

# Security
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000
RATE_LIMIT_ENABLED=True
