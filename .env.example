# Flask Configuration
FLASK_APP=ngo_homesuite.wsgi:app
FLASK_ENV=development
# Set either SECRET_KEY or FLASK_SECRET_KEY. If omitted, runtime generates and persists a key on first run.
SECRET_KEY=
FLASK_SECRET_KEY=
# Optional: file path containing only the Flask secret key (recommended for Docker/K8s secrets).
# Example: SECRET_KEY_FILE=/run/secrets/secret_key
SECRET_KEY_FILE=
# Optional alias for the same behavior as SECRET_KEY_FILE.
FLASK_SECRET_KEY_FILE=
NGO_HOMESUITE_SECRET_FILE=data/.secret_key

# Database Configuration
# Production recommendation (PostgreSQL): provide the DSN via DATABASE_URL_FILE
# so credentials stay out of committed files and shell history.
DATABASE_URL=
DATABASE_URL_FILE=
# For local quick demos only:
# DATABASE_URL=sqlite:///ngo_homesuite.db
# For MySQL, also prefer DATABASE_URL_FILE with a secret-managed DSN.

# Docker Compose PostgreSQL settings
POSTGRES_DB=ngo_homesuite
POSTGRES_USER=ngohs
POSTGRES_PASSWORD=

# Database Encryption (Optional)
NGO_HOMESUITE_DB_KEY=

# Server Configuration
FLASK_DEBUG=False
FLASK_TESTING=False
HOST=127.0.0.1
PORT=8000

# Session Configuration
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=2592000
SESSION_STORE_BACKEND=cookie
REDIS_URL=
REDIS_KEY_PREFIX=ngohs:

# Authentication
LOGIN_ATTEMPTS_LIMIT=5
LOGIN_ATTEMPTS_TIMEOUT=900

# OAuth / SSO (optional, enable any provider by setting both ID + secret)
OAUTH_REDIRECT_BASE=
HIDE_SSO_OPTIONS=1
SHOW_DEV_LOGIN_CREDENTIALS=0
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
# Example: https://dev-123456.okta.com/.well-known/openid-configuration
OKTA_SERVER_METADATA_URL=

# Auth support / compliance links (optional)
SUPPORT_EMAIL=
STATUS_PAGE_URL=
PRIVACY_URL=
TERMS_URL=
COOKIES_URL=

# Email Configuration (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
DEFAULT_MAIL_SENDER=noreply@ngohomesuite.local

# AWS Configuration (Optional - for S3 backup/storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=ngo-homesuite-backups

# Azure Configuration (Optional)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Ollama/AI Configuration (Optional)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2
COPILOT_ENABLED=True
COPILOT_RAG_K=6
COPILOT_TOOL_ALLOWLIST=list_recent_donations,search_donors,donor_profile_insights,summarize_donor,find_similar_donors,rank_donors_for_outreach,suggest_outreach_targets,draft_personalized_appeal,organization_financial_summary,generate_report,generate_grant_report_draft,create_donor,export_donors_snapshot,run_reconciliation,execute_donation_followup_workflow
COPILOT_REQUIRE_APPROVAL_TOKEN=True
COPILOT_APPROVAL_TOKEN_TTL_SEC=300
COPILOT_TOOL_TIMEOUT_SEC=8
COPILOT_CONVERSATION_MAX_MESSAGES=200

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ngo_homesuite.log
STRUCTURED_LOGS_JSON=True
METRICS_ENABLED=True

# Security
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000
RATE_LIMIT_ENABLED=True
RATELIMIT_DEFAULT=200 per day, 50 per hour

# Migration Reliability
NGO_HOMESUITE_MIGRATION_TIMEOUT_SEC=30
NGO_HOMESUITE_BACKUP_BEFORE_MIGRATE=1
NGO_HOMESUITE_REQUIRE_BACKUP_BEFORE_MIGRATE=1
NGO_HOMESUITE_MIGRATION_BACKUP_WARN_ONLY=0
NGO_HOMESUITE_RESTORE_BACKUP_ON_MIGRATION_FAIL=1

# Optional Azure Key Vault Integration (bring your own resolver in infra scripts)
AZURE_KEYVAULT_URL=
AZURE_SECRET_NAME_FLASK_KEY=
